# U-Calm Aviation — local development environment variables.
#
# Copy this file to .env.local (which is gitignored) and replace the
# placeholders with real values for local dev. In production these same
# variables are set in Cloudflare Pages → Project Settings → Environment
# variables, NOT in any committed file.
#
# Two are needed at build time (Vite injects them into the bundle):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
# These come from Project Settings → API in your Supabase dashboard.
# The "publishable" key is the long eyJ... JWT labelled "anon public".

# --- Supabase client (build-time, baked into bundle) -----------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# --- Resend (only needed if running the Edge Function locally with `supabase functions serve`) ---
# In production this is a Supabase Function secret, not an env var.
RESEND_API_KEY=re_your-api-key-here

# --- Optional: override notification email destination ----------------
# Until u-calmaviation.com is set up as a Google Workspace alias domain,
# leave this set to jp@u-calm.com so notifications still land somewhere
# you read. Once the alias is live, swap to flyhigh@u-calmaviation.com.
NOTIFY_EMAIL=jp@u-calm.com

# --- Optional: override Resend sender domain --------------------------
# Until u-calmaviation.com is verified as a sending domain in Resend,
# leave at resend.dev so the function can use the onboarding sender.
FROM_DOMAIN=resend.dev
